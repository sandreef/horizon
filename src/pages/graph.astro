---
import Base from '../layouts/Base.astro';
import { AREAS } from '../lib/areas';
import { getNotes, getPaths, noteUrl, outlinks, pathUrl } from '../lib/notes';

const [notes, paths] = await Promise.all([getNotes(), getPaths()]);
const ids = new Set(notes.map((n) => n.id));
const nodes = [
  ...paths.map((p) => ({ id: `path:${p.id}`, label: p.data.title, area: p.data.area, url: pathUrl(p), hub: true })),
  ...notes.map((n) => ({ id: n.id, label: n.data.title, area: n.data.area, url: noteUrl(n), hub: false })),
];
const links = [
  ...notes.flatMap((n) => outlinks(n).filter((t) => ids.has(t)).map((t) => ({ s: n.id, t }))),
  ...notes.filter((n) => n.data.milestone && paths.some((p) => p.id === n.data.milestone!.split('/')[0])).map((n) => ({ s: n.id, t: `path:${n.data.milestone!.split('/')[0]}` })),
];
const graph = JSON.stringify({ nodes, links });
---
<Base title="Knowledge graph" description="How the notes and learning paths connect.">
  <header class="page-head">
    <p class="eyebrow">Knowledge graph</p>
    <h1>How it all connects</h1>
    <p class="lede">
      Every note is a dot, every <code>[[link]]</code> a line, and the large dots are the learning paths. Drag to
      rearrange, scroll to zoom, click to open. Clusters show what you know well; lonely dots are invitations to link.
    </p>
  </header>
  <div class="graph-wrap">
    <canvas data-graph={graph} aria-label="Graph of notes and links"></canvas>
    <div class="graph-tip" data-tip></div>
    <div class="graph-legend">{AREAS.map((a) => <span class={`pill pill-area pill-dot area-${a.id}`}>{a.short}</span>)}</div>
  </div>
  <p class="small muted" style="margin-top:0.8rem">{notes.length} notes · {links.length} links · {paths.length} paths</p>

  <script>
    type N = { id: string; label: string; area: string; url: string; hub: boolean; x: number; y: number; vx: number; vy: number; r: number; deg: number };
    const canvas = document.querySelector<HTMLCanvasElement>('[data-graph]')!;
    const tip = document.querySelector<HTMLElement>('[data-tip]')!;
    const data = JSON.parse(canvas.dataset.graph!) as { nodes: N[]; links: { s: string; t: string }[] };
    const ctx = canvas.getContext('2d')!;
    const byId = new Map<string, N>();
    data.nodes.forEach((n, i) => {
      const a = (i / data.nodes.length) * Math.PI * 2;
      Object.assign(n, { x: Math.cos(a) * 200, y: Math.sin(a) * 200, vx: 0, vy: 0, deg: 0 });
      byId.set(n.id, n);
    });
    const links = data.links.map((l) => ({ s: byId.get(l.s)!, t: byId.get(l.t)! })).filter((l) => l.s && l.t);
    links.forEach((l) => { l.s.deg++; l.t.deg++; });
    data.nodes.forEach((n) => (n.r = n.hub ? 14 : 5 + Math.min(6, n.deg * 1.2)));

    let W = 0, H = 0, dpr = 1, scale = 1, ox = 0, oy = 0;
    let hover: N | null = null, drag: N | null = null, panning = false, alpha = 1;
    let last = { x: 0, y: 0 }, moved = false;

    const css = (v: string) => getComputedStyle(document.documentElement).getPropertyValue(v).trim();
    const colors = () => ({
      ai: css('--ai'), programming: css('--programming'), 'system-design': css('--system-design'), 'science-tech': css('--science-tech'),
      line: css('--border-2'), text: css('--text'), muted: css('--muted'), bg: css('--surface'),
    } as Record<string, string>);
    let C = colors();
    new MutationObserver(() => { C = colors(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    function resize() {
      const r = canvas.getBoundingClientRect();
      dpr = window.devicePixelRatio || 1;
      W = r.width; H = r.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
    }
    resize();
    window.addEventListener('resize', resize);

    function tick() {
      if (alpha > 0.005) {
        const ns = data.nodes;
        for (let i = 0; i < ns.length; i++) {
          for (let j = i + 1; j < ns.length; j++) {
            const a = ns[i], b = ns[j];
            let dx = b.x - a.x, dy = b.y - a.y;
            let d2 = dx * dx + dy * dy || 0.01;
            const f = (1800 * alpha) / d2;
            const d = Math.sqrt(d2);
            dx /= d; dy /= d;
            a.vx -= dx * f; a.vy -= dy * f; b.vx += dx * f; b.vy += dy * f;
          }
        }
        for (const l of links) {
          const dx = l.t.x - l.s.x, dy = l.t.y - l.s.y;
          const d = Math.sqrt(dx * dx + dy * dy) || 1;
          const want = l.s.hub || l.t.hub ? 110 : 80;
          const f = ((d - want) / d) * 0.04 * alpha;
          l.s.vx += dx * f; l.s.vy += dy * f; l.t.vx -= dx * f; l.t.vy -= dy * f;
        }
        for (const n of ns) {
          n.vx -= n.x * 0.004 * alpha; n.vy -= n.y * 0.004 * alpha;
          if (n === drag) { n.vx = n.vy = 0; continue; }
          n.vx *= 0.82; n.vy *= 0.82;
          n.x += n.vx; n.y += n.vy;
        }
        alpha *= 0.992;
      }
      draw();
      requestAnimationFrame(tick);
    }

    function draw() {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, W, H);
      ctx.translate(W / 2 + ox, H / 2 + oy);
      ctx.scale(scale, scale);
      const near = new Set<N>();
      if (hover) { near.add(hover); links.forEach((l) => { if (l.s === hover) near.add(l.t); if (l.t === hover) near.add(l.s); }); }
      ctx.lineWidth = 1 / scale;
      for (const l of links) {
        const lit = hover && (l.s === hover || l.t === hover);
        ctx.strokeStyle = lit ? C[hover!.area] : C.line;
        ctx.globalAlpha = hover && !lit ? 0.25 : 0.9;
        ctx.beginPath(); ctx.moveTo(l.s.x, l.s.y); ctx.lineTo(l.t.x, l.t.y); ctx.stroke();
      }
      for (const n of data.nodes) {
        ctx.globalAlpha = hover && !near.has(n) ? 0.3 : 1;
        ctx.fillStyle = C[n.area];
        ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2); ctx.fill();
        if (n.hub) { ctx.strokeStyle = C.bg; ctx.lineWidth = 3 / scale; ctx.stroke(); ctx.lineWidth = 1 / scale; }
        if (n.hub || scale > 1.4 || near.has(n)) {
          ctx.fillStyle = n.hub ? C.text : C.muted;
          ctx.font = `${n.hub ? 600 : 500} ${(n.hub ? 13 : 11) / Math.max(scale, 0.8)}px Inter, system-ui, sans-serif`;
          ctx.textAlign = 'center';
          ctx.fillText(n.label.length > 34 ? n.label.slice(0, 32) + '…' : n.label, n.x, n.y + n.r + 13 / Math.max(scale, 0.8));
        }
      }
      ctx.globalAlpha = 1;
    }

    const toWorld = (cx: number, cy: number) => {
      const r = canvas.getBoundingClientRect();
      return { x: (cx - r.left - W / 2 - ox) / scale, y: (cy - r.top - H / 2 - oy) / scale };
    };
    const pick = (cx: number, cy: number) => {
      const p = toWorld(cx, cy);
      let best: N | null = null, bd = Infinity;
      for (const n of data.nodes) { const d = Math.hypot(n.x - p.x, n.y - p.y); if (d < n.r + 6 / scale && d < bd) { bd = d; best = n; } }
      return best;
    };

    canvas.addEventListener('pointerdown', (e) => {
      canvas.setPointerCapture(e.pointerId);
      last = { x: e.clientX, y: e.clientY }; moved = false;
      drag = pick(e.clientX, e.clientY);
      panning = !drag;
      canvas.style.cursor = 'grabbing';
    });
    canvas.addEventListener('pointermove', (e) => {
      const dx = e.clientX - last.x, dy = e.clientY - last.y;
      if (Math.abs(dx) + Math.abs(dy) > 3) moved = true;
      if (drag) { const p = toWorld(e.clientX, e.clientY); drag.x = p.x; drag.y = p.y; alpha = Math.max(alpha, 0.3); }
      else if (panning) { ox += dx; oy += dy; }
      else {
        hover = pick(e.clientX, e.clientY);
        canvas.style.cursor = hover ? 'pointer' : 'grab';
        if (hover) {
          const r = canvas.getBoundingClientRect();
          tip.textContent = hover.label; tip.style.opacity = '1';
          tip.style.left = `${e.clientX - r.left}px`; tip.style.top = `${e.clientY - r.top}px`;
        } else tip.style.opacity = '0';
      }
      last = { x: e.clientX, y: e.clientY };
    });
    canvas.addEventListener('pointerup', (e) => {
      const n = drag;
      drag = null; panning = false; canvas.style.cursor = 'grab';
      if (n && !moved) window.location.href = n.url;
    });
    canvas.addEventListener('pointerleave', () => { hover = null; tip.style.opacity = '0'; });
    canvas.addEventListener('wheel', (e) => {
      e.preventDefault();
      const r = canvas.getBoundingClientRect();
      const mx = e.clientX - r.left - W / 2, my = e.clientY - r.top - H / 2;
      const k = Math.exp(-e.deltaY * 0.0015);
      const ns = Math.min(4, Math.max(0.3, scale * k));
      ox = mx - ((mx - ox) * ns) / scale; oy = my - ((my - oy) * ns) / scale;
      scale = ns;
    }, { passive: false });

    tick();
  </script>
</Base>
