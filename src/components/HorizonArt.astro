---
// The home page sea: sky, sun on the horizon, and slow waves. Colors come from the theme.
// The sea is a fixed-height band at the bottom of the hero, so text never runs into it.
---
<div class="hero-art" aria-hidden="true">
  <div class="hero-glow"></div>
  <div class="hero-sky"><div class="hero-sun"></div></div>
  <svg class="hero-sea" viewBox="0 0 1200 190" preserveAspectRatio="none">
    <defs>
      <linearGradient id="sea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--sea-top)" />
        <stop offset="1" stop-color="var(--sea-bottom)" />
      </linearGradient>
    </defs>
    <rect x="0" y="0" width="1200" height="190" fill="url(#sea)" />
    <g class="glint" stroke="var(--sun)" stroke-linecap="round" opacity="0.6">
      <path d="M860 15h80M875 28h50M885 41h30M893 54h14" stroke-width="2.5" vector-effect="non-scaling-stroke" />
    </g>
    <g fill="none" stroke="#ffffff" stroke-linecap="round">
      <path class="wave" d="M-60 50 C 90 38, 210 62, 360 50 S 630 38, 780 50 S 1050 62, 1260 48" stroke-opacity="0.22" stroke-width="1.5" vector-effect="non-scaling-stroke" />
      <path class="wave wave-2" d="M-60 82 C 120 68, 260 96, 420 82 S 700 68, 860 82 S 1110 96, 1260 80" stroke-opacity="0.16" stroke-width="1.5" vector-effect="non-scaling-stroke" />
      <path class="wave wave-3" d="M-60 116 C 100 102, 250 132, 410 116 S 690 102, 850 116 S 1100 132, 1260 114" stroke-opacity="0.12" stroke-width="1.5" vector-effect="non-scaling-stroke" />
    </g>
    <line x1="0" y1="0.5" x2="1200" y2="0.5" stroke="#ffffff" stroke-opacity="0.35" vector-effect="non-scaling-stroke" />
  </svg>
</div>
