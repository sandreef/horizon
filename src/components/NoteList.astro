---
import AreaPill from './AreaPill.astro';
import { NOTE_TYPES, formatDate, isoDate, noteUrl, type Note } from '../lib/notes';
interface Props { notes: Note[]; showArea?: boolean }
const { notes, showArea = true } = Astro.props;
---
<ul class="note-list">
  {notes.map((n) => (
    <li>
      <time datetime={isoDate(n.data.date)}>{formatDate(n.data.date)}</time>
      <div>
        <a href={noteUrl(n)}>{n.data.title}</a>
        <span class="kind muted small">{NOTE_TYPES[n.data.type]}</span>
        {showArea && <> <AreaPill area={n.data.area} /></>}
        {n.data.starter && <span class="pill pill-starter">starter</span>}
        {n.data.summary && <p class="summary">{n.data.summary}</p>}
      </div>
    </li>
  ))}
</ul>
