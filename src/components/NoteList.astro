---
import { areaById } from '../lib/areas';
import { formatDate, isoDate, noteUrl, type Note } from '../lib/notes';

interface Props {
  notes: Note[];
  showArea?: boolean;
}
const { notes, showArea = true } = Astro.props;
---
<ul class="note-list">
  {
    notes.map((n) => (
      <li>
        <time datetime={isoDate(n.data.date)}>{formatDate(n.data.date)}</time>
        <div>
          <a href={noteUrl(n)}>{n.data.title}</a>
          {showArea && <span class="pill" style="margin-left:0.5rem">{areaById(n.data.area)?.name}</span>}
          {n.data.sample && <span class="pill sample-badge">sample</span>}
          {n.data.draft && <span class="pill sample-badge">draft</span>}
          {n.data.summary && <p class="summary">{n.data.summary}</p>}
        </div>
      </li>
    ))
  }
</ul>
