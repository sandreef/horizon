---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Search from '../components/Search.astro';
import { AREAS } from '../lib/areas';
import { url } from '../lib/notes';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'A public notebook of what I am learning: AI, programming, system design, and science.' } = Astro.props;
const pageTitle = title ? `${title} · Horizon` : 'Horizon';
const path = Astro.url.pathname;
const nav = [
  ...AREAS.map((a) => ({ href: url(`${a.id}/`), label: a.name })),
  { href: url('log/'), label: 'Log' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={url('')}><Logo /> Horizon</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="search-btn" type="button" data-open-search aria-label="Search notes">
          Search <kbd>⌘K</kbd>
        </button>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        Horizon is a personal learning notebook. Notes are in my own words; sources are linked from each note.
      </div>
    </footer>
    <Search />
  </body>
</html>
